# 复制到 /etc/calendar-pick/cfa.env，chmod 600
# 不要提交到 git，也不要把这个文件放到 nginx 能访问的目录

# auto：用账号密码自动登录，token 快过期时自动续
# manual：只用 CFA_AUTHORIZATION，到期前靠告警提醒
CFA_AUTH_MODE=auto
CFA_ACCOUNT=
CFA_PASSWORD=
# 兜底 token；auto 登录失败时会尝试它。可留空
CFA_AUTHORIZATION=

# 运行时数据目录（nginx /runtime/ 指向它的 runtime 子目录）
RUNTIME_DIR=/var/lib/calendar-pick/runtime
# 私有状态目录（token 缓存、内容哈希），不要对外
STATE_DIR=/var/lib/calendar-pick/state
# 首次运行补历史场次用的 display 配置
SEED_DIR=/opt/calendar-pick/seed

SYNC_INTERVAL_HOURS=8
ICS_PAST_DAYS=3
REQUEST_TIMEOUT_MS=15000

# 告警：bark / wecom / telegram / webhook / log
# Bark 最省事：iPhone 装 Bark，复制 https://api.day.app/xxxxx 填到下面
ALERT_CHANNEL=bark
BARK_URL=
WECOM_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

SITE_ORIGIN=https://cal.wind8866.top
